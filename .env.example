PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/raavanan_migrated
# Remote PostgreSQL: require encrypts; verify-full also checks the server using PGSSLROOTCERT.
PGSSLMODE=disable
PGSSLROOTCERT=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost:5173

# Brevo's HTTPS API works on Render's free plan. Register/verify this sender in Brevo.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
BREVO_SENDER_EMAIL=ramkumarperaman.p@gmail.com
BREVO_SENDER_NAME=Raavana Thalaigal Trust

# SMTP fallback for local development or a paid host. Render free blocks SMTP ports.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Raavana Thalaigal Trust <no-reply@example.com>"
# Leave false when keeping existing records. Import before starting the API.
SEED_DEMO_DATA=false

# Used only by npm run db:import:mongo, never by the running API.
MONGODB_URI=
MONGODB_DATABASE=raavana_trust
# Optional: DNS resolver for the MongoDB driver if SRV lookup fails locally.
MONGODB_DNS_SERVER=
# When the running API database already has records, import into a new empty database.
MONGO_IMPORT_DATABASE=raavanan_migrated
# Optional local directory containing mongoexport JSON/JSONL files.
MONGO_EXPORT_DIR=
